DASHSCOPE_API_KEY=
# Optional: use your workspace/region-specific endpoint and its matching regional key.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Backend-only WeChat credentials; never copy these to the mini program.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_TOKEN=
WECHAT_ENCODING_AES_KEY=
# HTTPS public origin; an optional reverse-proxy path prefix is supported.
PUBLIC_BASE_URL=
# Moderation state is process-local: run one Uvicorn worker, one backend instance.
# Fixed defaults: jobs 35 minutes, capacity 100, pending 20, pending per OpenID 2.
